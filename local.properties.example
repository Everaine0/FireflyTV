# 复制成 local.properties 再填自己的值。local.properties 不入库。
#
# 这里的账号只用于**插桩测试**连真实的 NAS / SMB 服务；
# 应用本身不读取这些值，它的配置来自电视上的二维码配置页。
#
# 留空则相关测试自动跳过（assumeTrue），不会失败。

ff.smb.host=
ff.smb.share=
ff.smb.user=
ff.smb.pass=
# 可选：域，以及共享内的根目录（例如共享下还有一层 tv 就填 tv）
ff.smb.domain=
ff.smb.root=

# 可选：NetworkDiagTest 要探测的直播源，逗号分隔的 host:port
# （地址因运营商/地区而异，所以不写进仓库；留空则跳过这一项诊断）
ff.live.targets=

# 心知天气（可选）：控制台里给的是一对「公钥 / 私钥」，
# 这里必须填**私钥** —— 公钥会被接口直接拒绝（AP010003）。
# 城市可以填地名，也可以填「纬度:经度」；有些地名在免费套餐里没有权限，
# 这时改用坐标一定行。应用里**没有默认地点**，两项要么都填、要么都留空。
ff.weather.key=
ff.weather.location=
