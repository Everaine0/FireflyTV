# 本地二进制依赖：ijkplayer AAR 不在 Maven 上，体积大不入库
# 用 ** 是为了连 app/libs/stock-aar/ 这种子目录里的也一起排除
app/libs/**/*.aar

# scripts/swap-ffmpeg-so.sh 换 .so 前会自动留一份 .aar.bak 备份。
# ⚠️ 上面那条通配符匹配不到 `.aar.bak`（结尾不是 .aar），少了这行就会有一个
# 17MB 的备份文件被误提交。
app/libs/**/*.bak

# 自己编译 ijkplayer 内核时的产物/中间产物（体积大、可重编，见 scripts/build-ijkplayer.sh）
build-out/

# 测试用媒体：由脚本生成，不入库（生成方式见 app/src/androidTest/assets/README.md）
#   make-test-media.ps1     -> *.mp4（moov 位置对照）
#   make-audio-fixtures.ps1 -> audio-*.ts（音频编码对照）
app/src/androidTest/assets/*.mp4
app/src/androidTest/assets/audio-*.ts

# 构建产物
*.iml
.gradle/
build/
.idea/
.DS_Store
captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab
*.keystore
*.jks

# 私密：真 NAS 测试账号等本机配置（模板见 local.properties.example）
local.properties

# 直播源播放列表：运营商真实地址 + 地区信息，且与源码无关 —— 只留本机，不入库
iptv/

# 打包好的 APK 留档目录（体积大、可重编；*.apk 那条已经排除了文件本身）
firefly-apk/

# Python 脚本（scripts/*.py）跑起来会留字节码，生成物不入库
__pycache__/
*.pyc
